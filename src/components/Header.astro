---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;

const navItems = [
  { href: "#how", rootHref: "/#how", label: "How it works", i18n: "nav.how" },
  { href: "#features", rootHref: "/#features", label: "Features", i18n: "nav.features" },
  { href: "#privacy", rootHref: "/#privacy", label: "Privacy", i18n: "nav.privacy" },
  { href: "#roadmap", rootHref: "/#roadmap", label: "Roadmap", i18n: "nav.roadmap" },
  { href: "#notes", rootHref: "/#notes", label: "Notes", i18n: "nav.notes" },
];
---

<header class="site-header" aria-label="Primary navigation">
  <a class="brand" href={isHome ? "#top" : "/"} aria-label="EverLog home">
    <span class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 36 36" role="img" aria-label="EverLog mark">
        <path d="M18 3.6c6.4 0 11.8 4.9 12.5 11.3.8 7.3-4.6 14.1-12.5 17.5C10.1 29 4.7 22.2 5.5 14.9 6.2 8.5 11.6 3.6 18 3.6Z" fill="currentColor" opacity=".18" />
        <path d="M12.1 18.4c2.2 0 3.2-7.2 5.9-7.2 2.7 0 3.7 13.6 5.9 13.6 1.6 0 2.5-4.1 3.9-6.4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    <span>EverLog</span>
  </a>
  <nav class="nav-links" aria-label="Page sections">
    {navItems.map((item) => (
      <a href={isHome ? item.href : item.rootHref} data-i18n={isHome ? item.i18n : undefined}>{item.label}</a>
    ))}
  </nav>
  <div class="header-actions">
    <button class="language-toggle" type="button" data-lang-toggle={isHome ? "" : undefined} aria-label="Switch language" disabled={!isHome} title={isHome ? "Switch language" : "Language switch is available on the homepage"}>
      <span data-lang-option="en">English</span>
      <span class="toggle-divider" aria-hidden="true">/</span>
      <span data-lang-option="zh">中文</span>
    </button>
    <a class="header-cta" href={isHome ? "#notes" : "/#notes"} data-i18n={isHome ? "nav.cta" : undefined}>Read notes</a>
  </div>
</header>
