{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lifelog.taotao.au"
        }
      ],
      "destination": "https://everlog.taotao.au/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "daylog.taotao.au"
        }
      ],
      "destination": "https://everlog.taotao.au/:path*",
      "permanent": true
    }
  ]
}
